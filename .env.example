# ===== OceanPedia — contoh konfigurasi (salin ke .env, JANGAN commit .env) =====

# --- Database (PostgreSQL 16) ---
POSTGRES_USER=oceanpedia
POSTGRES_PASSWORD=change-me
POSTGRES_DB=oceanpedia
DATABASE_URL=postgres://oceanpedia:change-me@localhost:5432/oceanpedia?sslmode=disable

# --- API (Go) ---
API_ADDR=:8080
API_ENV=development               # development | staging | production
API_CORS_ORIGINS=http://localhost:3000
API_JWT_SECRET=ganti-dengan-32-karakter-acak-atau-lebih
API_RATE_LIMIT_RPS=20
API_RUN_MIGRATIONS=true

# --- Data pasar (hanya di server, jangan pernah di frontend) ---
TWELVEDATA_API_KEY=
TWELVEDATA_CACHE_TTL=60s

# --- Web (Next.js) ---
API_INTERNAL_URL=http://localhost:8080   # dipakai server Next.js
NEXT_PUBLIC_SITE_URL=http://localhost:3000
