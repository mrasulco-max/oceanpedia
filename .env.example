# ===== OceanPedia — contoh konfigurasi (salin ke .env, JANGAN commit .env) =====

# --- Database (PostgreSQL 16) ---
POSTGRES_USER=oceanpedia
POSTGRES_PASSWORD=change-me
POSTGRES_DB=oceanpedia
DATABASE_URL=postgres://oceanpedia:change-me@localhost:5432/oceanpedia?sslmode=disable

# --- API (Go) ---
API_ADDR=:8080
API_ENV=development               # development | staging | production
API_CORS_ORIGINS=http://localhost:3000
API_JWT_SECRET=ganti-dengan-32-karakter-acak-atau-lebih
API_RATE_LIMIT_RPS=20
API_RUN_MIGRATIONS=true

# --- OTP email (daftar, masuk dengan kode, lupa kata sandi) via Bird ---
# Kosongkan BIRD_API_KEY hanya untuk pengembangan lokal: kode OTP selalu 000000.
BIRD_API_KEY=                    # Bird Verify (cadangan bila email domain sendiri gagal)
BIRD_API_URL=                    # opsional, default https://eu1.platform.bird.com
BIRD_EMAIL_KEY=                  # Bird Email (izin emails:write) untuk kirim kode dari domain sendiri
OTP_EMAIL_FROM=                  # mis. "OceanBird <noreply@mail.domainkamu.id>"

# --- Data pasar Twelve Data (https://twelvedata.com/docs) — hanya di server ---
# Endpoint yang dipakai: GET /quote (batch symbol=A,B,C), GET /time_series, kripto via Binance.
# Daftar kunci: https://twelvedata.com/account/api-keys
TWELVEDATA_API_KEY=
TWELVEDATA_CACHE_TTL=60s
# TWELVEDATA_QUOTE_TTL=15m
# TWELVEDATA_CANDLE_TTL=1h
# TWELVEDATA_SKIP=IDX,JKSE,JKLQ45


# --- Kalender ekonomi (XOOMAR diutamakan, rilis makro AS) ---
# Docs: https://xoomar.com/markets/api/calendar
# GET https://xoomar.com/api/markets/calendar?from=YYYY-MM-DD&to=YYYY-MM-DD
# Tanpa kunci: 10 req/menit/IP; XOOMAR_API_KEY opsional → 30 req/menit.
# XOOMAR_CALENDAR: auto | on | off (default auto → pakai Xoomar)
XOOMAR_CALENDAR=auto
XOOMAR_API_KEY=
# Cadangan bila XOOMAR_CALENDAR=off: TradingView (feed publik / Data API)
# SOURCE: auto | api | public | off
TRADINGVIEW_CALENDAR_SOURCE=auto
TRADINGVIEW_API_KEY=
TRADINGVIEW_API_BASE=https://api.tradingviewapi.com
TRADINGVIEW_CALENDAR_TTL=15m
TRADINGVIEW_CALENDAR_MARKETS=america,china,indonesia

# --- Web (Next.js) ---
API_INTERNAL_URL=http://localhost:8080   # dipakai server Next.js
NEXT_PUBLIC_SITE_URL=http://localhost:3000
